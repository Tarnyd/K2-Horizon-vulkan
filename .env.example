# Copy to .env to override defaults (never commit .env with secrets).
K2_PORT=11436
MODEL_ALIAS=
CTX_SIZE=8192
CTX_SIZE_7B=4096
N_GPU_LAYERS=999
OLLAMA_ORIGINS=*
VERBOSITY=4
# Thinking: cap on reasoning tokens per reply (hard cap, then it answers).
# -1 = unlimited (runaway thinking), 256 = snappy but dumber, empty = no cap flag.
REASONING_BUDGET=1024
# REASONING=off turns thinking off entirely (on/off/auto).
REASONING=
